// Kullanıcı Modeli
public class User {
    public string Username { get; set; }
    public string Password { get; set; }
}

// Kayıt Listesi (Gerçek projede bu bir veritabanı olur)
List<User> userDatabase = new List<User>();

void KayitOl(string name, string pass) {
    userDatabase.Add(new User { Username = name, Password = pass });
}
